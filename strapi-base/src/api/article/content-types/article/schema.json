{
  "kind": "collectionType",
  "collectionName": "articles",
  "info": {
    "singularName": "article",
    "pluralName": "articles",
    "displayName": "2.0.0 - Article",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "_softDeletedAt": {
      "type": "datetime",
      "configurable": false,
      "writable": false,
      "visible": false,
      "private": true
    },
    "_softDeletedById": {
      "type": "integer",
      "configurable": false,
      "writable": false,
      "visible": false,
      "private": true
    },
    "_softDeletedByType": {
      "type": "string",
      "configurable": false,
      "writable": false,
      "visible": false,
      "private": true
    },
    "PageTitle": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "string"
    },
    "PageSlug": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "customField",
      "options": {
        "targetField": "PageTitle"
      },
      "customField": "plugin::ab-custom-slug.ab-custom-slug"
    },
    "PageDescription": {
      "type": "customField",
      "options": {
        "output": "HTML",
        "preset": "standard"
      },
      "customField": "plugin::ckeditor.CKEditor"
    },
    "Image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "ArticleCategory": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::article-category.article-category",
      "inversedBy": "Articles"
    },
    "PublishedDate": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "datetime"
    },
    "Components": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "dynamiczone",
      "components": [
        "blocks.content",
        "blocks.news-listing",
        "header.explore-header-block",
        "header.header"
      ]
    }
  }
}
